<%- include('../topbar', { title: 'Notifications', subtitle: 'Activité de votre compte.' }) %>
<%- include('../flash') %>

<div class="toolbar">
  <% if (items.some((n) => n.statut_notification === 'Non lue')) { %>
    <form method="post" action="/notifications/lire-toutes" class="inline-form" data-spa-form>
      <button class="btn" type="submit"><%- icon('list-checks') %> Tout marquer lu</button>
    </form>
  <% } %>
</div>

<% if (!items.length) { %>
  <div class="card empty-state">
    <%- icon('bell') %>
    <p>Aucune notification.</p>
  </div>
<% } else { %>
  <div class="list">
    <% items.forEach((n) => { %>
      <div class="list-item notification-item <%= n.statut_notification === 'Non lue' ? 'unread' : '' %>">
        <div>
          <strong><%= n.contenu_notification %></strong>
          <p><%= formatDateTime(n.date_notification) %> <span class="badge <%= n.statut_notification === 'Non lue' ? 'warning' : 'neutral' %>"><%= n.statut_notification %></span></p>
        </div>
        <% if (n.statut_notification === 'Non lue') { %>
          <form method="post" action="/notifications/<%= n.id_notification %>/lire" class="inline-form" data-spa-form>
            <button class="btn" type="submit"><%- icon('check') %> Marquer lue</button>
          </form>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } %>
