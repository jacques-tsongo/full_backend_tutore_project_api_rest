<%- include('partials/head', { title, page: 'matching' }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { active: 'matching' }) %>
  <main class="main">
    <%- include('partials/topbar', { title: 'Matching', subtitle: 'Compatibilité entre vos compétences et les offres ouvertes.' }) %>
    <%- include('partials/flash') %>

    <% if (!items.length) { %>
      <div class="card empty-state">
        <%- icon('target') %>
        <p>Aucune offre compatible avec vos compétences pour le moment.</p>
        <a class="btn" href="/profil"><%- icon('user') %> Enrichir mes compétences</a>
      </div>
    <% } else { %>
      <% // Grille de cartes : chaque offre porte son propre bouton de calcul de
         // compatibilité [data-match-button] et sa zone de score [data-score-zone],
         // pilotés par /js/pages/matching.js (GET /api/offres/:id/matching, score
         // persisté côté serveur dans la table `matching`). %>
      <div class="grid match-grid" data-match-grid>
        <% items.forEach((job) => { %>
          <article class="card offer-card" data-offre-id="<%= job.id_offre %>">
            <div class="offer-main">
              <strong class="offer-title"><a href="/offres/<%= job.id_offre %>"><%= job.titre_offre %></a></strong>
              <p class="muted-note">
                <%- icon('building-2') %> <%= job.nom_entreprise || '—' %> ·
                <%- icon('map-pin') %> <%= job.localisation %> ·
                <%- icon('calendar') %> expire le <%= formatDate(job.date_expiration) %>
                <% if (job.salaire) { %> · <%- icon('coins') %> <%= job.salaire %> $<% } %>
              </p>
            </div>
            <div class="match-score-zone" data-score-zone></div>
            <div class="nav-actions">
              <a class="btn" href="/offres/<%= job.id_offre %>"><%- icon('eye') %> Détails</a>
              <button class="btn primary" type="button" data-match-button><%- icon('target') %> Calculer la compatibilité</button>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
<script src="/js/pages/matching.js" defer></script>
<%- include('partials/foot') %>