<%- include('partials/head', { title, page: 'candidatures' }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { active: 'candidatures' }) %>
  <main class="main">
    <%- include('partials/topbar', { title: 'Candidatures reçues', subtitle: 'Examinez les profils et mettez à jour les statuts.' }) %>
    <%- include('partials/flash') %>

    <% if (!items.length) { %>
      <div class="card empty-state">
        <%- icon('inbox') %>
        <p>Aucune candidature reçue pour vos offres.</p>
        <a class="btn primary" href="/dashboard#nouvelle-offre">Publier une offre</a>
      </div>
    <% } else { %>
      <div class="list" data-applications-list>
        <% items.forEach((x) => { %>
          <div class="card application-card" data-candidature-id="<%= x.id_candidature %>">
            <div class="offer-head">
              <div class="user-cell">
                <span class="avatar-img">
                  <% if (x.photo) { %><img src="<%= asset(x.photo) %>" alt="<%= `${x.prenom} ${x.nom}` %>"><% } else { %><span class="avatar-fallback"><%= ((x.prenom || ' ')[0] + (x.nom || ' ')[0]).toUpperCase() %></span><% } %>
                </span>
                <div>
                  <strong><%= x.prenom %> <%= x.nom %></strong>
                  <p class="muted-note">
                    <%- icon('mail') %> <%= x.email || '' %>
                    <% if (x.telephone) { %> · <%- icon('phone') %> <%= x.telephone %><% } %>
                  </p>
                  <p class="muted-note">Offre : <a href="/offres/<%= x.id_offre %>"><%= x.titre_offre %></a> · Postulé le <%= formatDate(x.date_candidature) %></p>
                </div>
              </div>
              <div class="nav-actions">
                <% if (x.score_compatibilite != null) { %><span class="badge info"><%- icon('target') %> Matching <%= x.score_compatibilite %>%</span><% } %>
                <span class="badge <%= statusClass(x.statut_candidature) %>"><%= x.statut_candidature %></span>
              </div>
            </div>
            <% if (x.lettre_motivation) { %><p><strong>Lettre de motivation :</strong> <%= x.lettre_motivation %></p><% } %>
            <% if (x.competences) { %><p><strong>Compétences :</strong> <%= x.competences %></p><% } %>
            <% if (x.bio) { %><p><strong>Bio :</strong> <%= x.bio %></p><% } %>
            <div class="nav-actions app-actions">
              <% if (x.cv) { %>
                <a class="btn" href="<%= asset(x.cv) %>" target="_blank" rel="noopener"><%- icon('download') %> Voir le CV</a>
              <% } %>
              <a class="btn" href="/messages?dest=<%= x.id_utilisateur %>"><%- icon('message-square') %> Contacter</a>
              <% if (['Acceptée', 'Refusée', 'Annulée'].includes(x.statut_candidature)) { %>
                <% // Décision finale : plus aucune action possible. %>
                <span class="badge neutral">Décision finale</span>
              <% } else if (x.offre_pourvue) { %>
                <% // L'offre a déjà été attribuée : l'acceptation est bloquée
                   // côté serveur (verrou transactionnel) — l'interface le
                   // reflète immédiatement. %>
                <span class="badge warning"><%- icon('circle-dot') %> Offre déjà attribuée</span>
              <% } else { %>
                <form method="post" action="/candidatures/<%= x.id_candidature %>/statut" class="inline-form" data-confirm="Accepter cette candidature ? L'offre sera attribuée et les autres candidatures seront refusées.">
                  <input type="hidden" name="statut_candidature" value="Acceptée">
                  <button class="btn success" type="submit"><%- icon('check') %> Accepter</button>
                </form>
                <form method="post" action="/candidatures/<%= x.id_candidature %>/statut" class="inline-form" data-confirm="Refuser cette candidature ?">
                  <input type="hidden" name="statut_candidature" value="Refusée">
                  <button class="btn danger" type="submit"><%- icon('x') %> Refuser</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
<script src="/js/pages/applications-received.js" defer></script>
<%- include('partials/foot') %>
