{
  "name": "gestion-carrieres-api",
  "version": "1.0.0",
  "description": "API REST de gestion des carrières et offres d'emploi",
  "main": "src/server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "db:check": "node scripts/db-integrity.js",
    "files:migrate": "node scripts/migrate-uploads.js",
    "mail:check": "node scripts/check-mail.js",
    "report:email-normalization": "node scripts/report-email-normalization.js",
    "swagger": "node -e \"require('fs').writeFileSync('swagger-output.json', JSON.stringify(require('./swagger'), null, 2))\"",
    "test:sql": "node test/sql-pagination-safety.js",
    "test:migrations": "node test/migrations-safety.js",
    "test:files": "node test/security-files.js",
    "test:filetype": "node test/filetype-compat.js",
    "test:uploads": "node test/upload-controllers.js",
    "test:messaging": "node test/messaging-policy.js",
    "test:idor": "node test/idor-resources.js",
    "test:constraints": "node test/db-constraints.js",
    "test:signup": "node test/signup-code-flow.js",
    "test:contract": "node test/exports-contract.js",
    "test:auth-flow": "node test/auth-controller-flow.js",
    "test:email-normalization": "node test/email-normalization.js",
    "test:rate-limit": "node test/rate-limit-api.js",
    "test:log-mask": "node test/log-mask.js",
    "test:matching:unit": "node test/matching-unit.js",
    "test:e2e": "node test/e2e-workflow.js",
    "test:matching": "node test/matching-ranking.js",
    "test:pages": "node test/frontend-smoke.js",
    "test:realtime": "node test/realtime-socket.js",
    "test:realtime-dom": "node test/realtime-dom.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.4.7",
    "ejs": "^6.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-static": "^1.30.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.9"
  }
}
