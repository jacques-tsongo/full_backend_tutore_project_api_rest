# Copiez ce fichier vers .env et adaptez les valeurs.
# Base de données MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_carrieres

# Authentification JWT
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Serveur
PORT=5000
NODE_ENV=development

# Stockage privé des fichiers téléversés (CV, photos, justificatifs...).
# Chemin relatif au dossier de l'application ou chemin absolu. Ce dossier ne
# doit JAMAIS être servi statiquement ; les fichiers passent par GET /files/:id.
STORAGE_DIR=./storage

# CORS (optionnel : liste d'origines séparées par des virgules)
# CORS_ORIGIN=http://localhost:5000

# ---------------------------------------------------------------------------
# Envoi d'e-mails (Nodemailer + Gmail, mot de passe d'application)
# ---------------------------------------------------------------------------
# Utilisez un compte Gmail DÉDIÉ à l'application (pas un compte personnel).
# Activez la validation en deux étapes, puis créez un mot de passe d'application
# (Compte Google → Sécurité → Mots de passe des applications) et collez les
# 16 caractères dans SMTP_PASS. Ne commitez jamais le fichier .env.
#
# MAIL_DRIVER : smtp (envoi réel), console (affiche le code dans le terminal,
#   développement uniquement), outbox (écrit les e-mails en JSON, tests).
#   console/outbox sont refusés en production ; smtp est refusé en test.
MAIL_DRIVER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=compte-dedie-linkemploi@gmail.com
# SMTP_PASS=abcdefghijklmnop
MAIL_FROM_NAME=LinkEmploi
# MAIL_FROM_EMAIL=compte-dedie-linkemploi@gmail.com
# Quota journalier de sécurité (Gmail : 500 destinataires / 24 h)
MAIL_DAILY_LIMIT=450
# Dossier de sortie pour le driver outbox (tests)
MAIL_OUTBOX_DIR=tmp/outbox

# ---------------------------------------------------------------------------
# Inscription par code de vérification e-mail (6 chiffres)
# ---------------------------------------------------------------------------
# Secret serveur HMAC des codes (>= 32 caractères). Génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans ce secret, les inscriptions sont bloquées (503).
# EMAIL_CODE_SECRET=remplacez-par-une-chaine-aleatoire-d-au-moins-32-caracteres
# Durée de validité du code en secondes (défaut 600 = 10 min, maximum 600)
EMAIL_CODE_TTL_SECONDS=600
# Délai minimal entre deux renvois (secondes)
EMAIL_CODE_RESEND_SECONDS=60
# Nombre maximal d'essais de code par inscription en attente
EMAIL_CODE_MAX_ATTEMPTS=5
# Nombre maximal de renvois (3 = 4 codes au total par inscription)
EMAIL_CODE_MAX_RESENDS=3
# Refus des adresses e-mail jetables
BLOCK_DISPOSABLE_EMAILS=true
