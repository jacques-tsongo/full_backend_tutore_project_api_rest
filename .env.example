# Copiez ce fichier vers .env et adaptez les valeurs.
# Base de données MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestion_carrieres

# Authentification JWT
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Serveur
PORT=5000
NODE_ENV=development

# CORS (optionnel : liste d'origines séparées par des virgules)
# CORS_ORIGIN=http://localhost:5000
